  "identityProviders": [
    {
      "alias": "orcid",
      "displayName": "ORCID",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "em accredited first login",
      "config": {
        "issuer": "${ORCID_ISSUER}",
        "authorizationUrl": "${ORCID_ISSUER}/oauth/authorize",
        "tokenUrl": "${ORCID_ISSUER}/oauth/token",
        "userInfoUrl": "${ORCID_ISSUER}/oauth/userinfo",
        "jwksUrl": "${ORCID_ISSUER}/oauth/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientAuthMethod": "client_secret_post",
        "clientId": "${ORCID_CLIENT_ID}",
        "clientSecret": "${ORCID_CLIENT_SECRET}",
        "defaultScope": "openid",
        "syncMode": "IMPORT",
        "pkceEnabled": "false",
        "disableUserInfo": "false",
        "hideOnLoginPage": "false",
        "guiOrder": "1"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username is the ORCID iD",
      "identityProviderAlias": "orcid",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "template": "${CLAIM.sub}",
        "target": "LOCAL",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "orcid attribute is the iD",
      "identityProviderAlias": "orcid",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "sub",
        "user.attribute": "orcid",
        "syncMode": "FORCE"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "em accredited first login",
      "description": "Only an ORCID iD the node manager accredited beforehand comes in: the user must already exist (username = iD); it is linked, never created.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"orcid\",\"displayName\":\"ORCID iD\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$\",\"error-message\":\"an ORCID iD is 0000-0000-0000-000X\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "localizationTexts": {
    "en": {
