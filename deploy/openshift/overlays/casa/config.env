# The house's addresses — not secret, and EMPTY until the conversation with the
# administrators has happened. Applied empty, the pod stops in Init:Error and
# the preflight names every line still to fill (`../../README.md`).
#
# Obligatory:
#   EM_PUBLIC_BASE        https://<the Route host>/em
#   OIDC_ISSUER           https://<keycloak>/realms/<realm>
#   OIDC_AUDIENCE         the client id the realm puts in `aud`
#   EM_ASSET_S3_ENDPOINT  https://<s3 endpoint>   (http:// only on a private network)
#   EM_ASSET_S3_BUCKET    the bucket (the server creates it if the key may)
EM_PUBLIC_BASE=
OIDC_ISSUER=
OIDC_AUDIENCE=
EM_ASSET_S3_ENDPOINT=
EM_ASSET_S3_BUCKET=
# Recommended — see base/configmap.yaml for the reason:
OIDC_JWKS_URI=
# Only if the house gives a PostgreSQL; both empty = revisions on the volume:
EM_DOCUMENTS_HOST=
EM_DOCUMENTS_DB=
# Who administers the node (ORCID iDs, comma-separated):
EM_OPERATORS=
